{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aside",
  "scopeName": "source.aside",
  "patterns": [
    { "include": "#comments" }, { "include": "#strings" },
    { "name": "keyword.control.aside", "match": "\\b(?:if|else|while|for|in|loop|match|is|await|return|break|continue|throw|yield|try|catch|finally)\\b" },
    { "name": "storage.modifier.aside", "match": "\\b(?:let|mut|async|gen|static|pub|use|as)\\b" },
    { "match": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "storage.type.aside" }, "2": { "name": "entity.name.function.aside" } } },
    { "match": "\\b(class)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "storage.type.aside" }, "2": { "name": "entity.name.type.aside" } } },
    { "name": "constant.language.aside", "match": "\\b(?:true|false|null)\\b" },
    { "name": "storage.type.aside", "match": "\\b(?:any|bool|int|float|string|array|table|Map|closure|Future|generator|Bytes|TextBuffer|ByteBuffer|Set|Range|Iterator|AsyncIterator|thread|weakref|instance|Binding)\\b" },
    { "name": "constant.numeric.aside", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b" },
    { "name": "entity.name.function.aside", "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()" },
    { "name": "variable.parameter.aside", "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*:(?!:))" },
    { "name": "keyword.operator.aside", "match": "\\?\\?|\\?\\.|=>|->|::|\\.\\.=?|[+*/%=<>!&|^~-]+" }
  ],
  "repository": {
    "comments": { "patterns": [
      { "name": "comment.line.documentation.aside", "begin": "///", "end": "$" },
      { "name": "comment.line.double-slash.aside", "begin": "//", "end": "$" },
      { "include": "#block-comment" }
    ] },
    "block-comment": { "name": "comment.block.aside", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block-comment" }] },
    "escape": { "name": "constant.character.escape.aside", "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)" },
    "interpolation": { "patterns": [
      { "name": "constant.character.escape.aside", "match": "\\{\\{|\\}\\}" },
      { "name": "meta.interpolation.aside", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#nested-braces" }, { "include": "$self" }] }
    ] },
    "nested-braces": { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#nested-braces" }, { "include": "$self" }] },
    "strings": { "patterns": [
      { "name": "string.quoted.triple.aside", "begin": "\\br\"\"\"", "end": "\"\"\"" },
      { "name": "string.quoted.triple.aside", "begin": "\\bf\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }] },
      { "name": "string.quoted.triple.aside", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#escape" }] },
      { "name": "string.quoted.double.aside", "begin": "\\br\"", "end": "\"|$" },
      { "name": "string.quoted.double.aside", "begin": "\\bf\"", "end": "\"|$", "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }] },
      { "name": "string.quoted.double.aside", "begin": "\"", "end": "\"|$", "patterns": [{ "include": "#escape" }] }
    ] }
  }
}
