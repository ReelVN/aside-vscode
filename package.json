{
  "name": "aside",
  "displayName": "Aside",
  "description": "Aside language support with the Rust compiler and Reel's built-in API definitions.",
  "version": "1.0.1",
  "publisher": "jhq223",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ReelVN/aside-vscode.git" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:aside"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available. Trust the workspace to launch its configured language server or run a story.",
      "restrictedConfigurations": ["aside.server.path", "aside.server.args", "aside.reel.path", "aside.reel.assets"]
    },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "languages": [{
      "id": "aside", "aliases": ["Aside", "aside"], "extensions": [".aside"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{ "language": "aside", "scopeName": "source.aside", "path": "./syntaxes/aside.tmLanguage.json" }],
    "snippets": [{ "language": "aside", "path": "./snippets/aside.json" }],
    "commands": [
      { "command": "aside.restartServer", "title": "Aside: Restart Language Server" },
      { "command": "aside.newFile", "title": "Aside: New File" },
      { "command": "aside.runProject", "title": "Aside: Run Project" }
    ],
    "configuration": {
      "title": "Aside",
      "properties": {
        "aside.server.path": {
          "type": "string", "default": "", "scope": "machine-overridable",
          "description": "Language server executable. Empty uses reel-lsp from PATH, then the bundled server. Use aside-lsp for standalone Aside."
        },
        "aside.server.args": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Arguments passed directly to the language server process." },
        "aside.reel.path": { "type": "string", "default": "reel", "scope": "machine-overridable", "description": "Reel CLI executable used by Run Project." },
        "aside.reel.assets": { "type": "string", "default": "", "description": "Resource directory override for Run Project, relative to the workspace folder. Empty uses the project's resources directory." }
      }
    },
    "configurationDefaults": {
      "[aside]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.defaultFormatter": "jhq223.aside",
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "off" },
        "editor.inlineSuggest.suppressSuggestions": false
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": { "vscode-languageclient": "9.0.1" },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2"
  }
}
